# Copy to config.env and fill in. config.env is gitignored — it holds a real
# AWS account and region, and it is not something this repository should carry.
#
# ------------------------------------------------------------------
# c7n-automation configuration
# ------------------------------------------------------------------

PROJECT_NAME="c7n-automation"
ENVIRONMENT="dev"
# The region the estate actually lives in. It was ap-southeast-1 while every
# workload - the VPC, the EKS cluster, both load balancers, all instances - sat
# in ap-south-1, so collection ran against an empty region and the architecture
# diagram came back with nothing in it. run-local.sh already defaulted to
# ap-south-1; this file was the one that disagreed.
#
# Note: .infra-state.env still points the Lambda automation at ap-southeast-1.
# It is generated by setup.sh and describes infrastructure that physically
# exists there, so it is NOT edited by hand - run setup.sh against ap-south-1
# to move it, or deploy.sh will push to an ECR repo that does not exist.
AWS_REGION=""
NOTIFICATION_EMAIL=""

# Lambda settings
LAMBDA_MEMORY="512"
LAMBDA_TIMEOUT="300"
