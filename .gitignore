# ---------------------------------------------------------------------------
# Operator data — never commit. origin is a PUBLIC repository.
#
# config.env and .infra-state.env carry a real AWS account id, ARNs and the
# deployed API endpoint. .infra-state.env is GENERATED by setup.sh and describes
# infrastructure that physically exists, so it is never hand-edited.
# Copy config.env.example to get started.
# ---------------------------------------------------------------------------
config.env
.infra-state.env
*.env
!*.env.example

# out/ is a real inventory of whichever account was last scanned — accounts.csv,
# assets.json, edges.csv. Regenerated every run; belongs to the operator.
out/
*.tfstate
*.tfstate.backup

# The console bakes an estate snapshot at dev time (`npm run predev` -> sync-live-data).
# It has previously contained live IAM access key IDs and a full ARN inventory.
console-app/src/lib/live-data.json
console-app/node_modules/
node_modules/
