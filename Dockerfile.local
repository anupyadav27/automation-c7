FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir c7n==0.9.35 pyyaml boto3

COPY policies/ /app/policies/
COPY handler.py /app/handler.py
COPY local-server.py /app/local-server.py

EXPOSE 8081
ENV LOCAL_PORT=8081
ENV POLICY_DIR=/app/policies

CMD ["python", "local-server.py"]
